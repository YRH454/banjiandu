{
  "version": "pair_itm_fair_v2",
  "kind": "new_scientific_protocol_not_historical_execution_registration",
  "training_seeds": [20260825, 20260826, 20260827],
  "data_construction_seed": 20260825,
  "datasets": ["apple", "cassava", "rice", "banana"],
  "main_budgets_percent": [1, 5, 10, 20, 30],
  "ablation_budgets_percent": [1, 5, 10, 20, 30, 100],
  "main_methods": ["bce", "meanteacher", "fixmatch", "softmatch", "simmatch", "freematch", "pairusa_ot"],
  "ablation_methods": ["bce", "pairusa", "ot", "pairusa_ot"],
  "model": {
    "image_size": 384,
    "vision_lora_layers": [10, 11],
