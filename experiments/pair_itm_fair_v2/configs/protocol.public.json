  "algorithms": {
    "meanteacher": {"unsup_warm_up": 0.4},
    "fixmatch": {"p_cutoff": 0.95},
    "softmatch": {"ema_p": 0.999, "n_sigma": 2, "variance_min": 1e-12},
    "simmatch": {"T": 0.5, "p_cutoff": 0.95, "proj_size": 128, "smoothing_alpha": 0.9, "da_len": 256, "in_loss_ratio": 1.0, "projector_seed_offset": 505, "projector_lr": 0.0002},
    "freematch": {"ema_p": 0.999, "ent_loss_ratio": 0.01, "use_quantile": false, "clip_thresh": false}
  },
  "augmentation": {
    "text": "complete_blind_caption_no_truncation_same_contract_for_all_methods",
    "weak": "bicubic_resize384_and_seeded_horizontal_flip",
    "strong": "same_flip_RandAugment_2ops_magnitude10_Cutout_0.125_no_crop",
    "same_views_for_same_cell_seed_successful_step": true
